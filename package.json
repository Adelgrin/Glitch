{
  "name": "glitch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.7.2",
    "emojibase-data": "^18.0.0",
    "livekit-client": "^2.23.0",
    "matrix-js-sdk": "^45.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "description": "Cliente Matrix com cara de Discord",
  "author": "Glitch",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.glitch.desktop",
    "productName": "Glitch",
    "copyright": "Glitch",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glitch",
      "artifactName": "Glitch-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Glitch-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "glitch",
      "maintainer": "Glitch <glitch@localhost>",
      "synopsis": "Cliente Matrix com cara de Discord",
      "description": "Glitch: cliente do protocolo Matrix com servidores, canais de voz, chamadas e transmissões no estilo do Discord.",
      "desktop": {
        "entry": {
          "Name": "Glitch",
          "Comment": "Cliente Matrix com cara de Discord",
          "Categories": "Network;InstantMessaging;Chat;",
          "StartupWMClass": "Glitch",
          "Keywords": "matrix;chat;discord;voz;"
        }
      },
      "artifactName": "Glitch-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 | libasound2t64"
      ]
    }
  },
  "homepage": "https://matrix.org"
}
