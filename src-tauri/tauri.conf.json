{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glitch",
  "version": "0.1.0",
  "identifier": "app.glitch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glitch",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Glitch",
    "copyright": "Glitch",
    "category": "SocialNetworking",
    "shortDescription": "Cliente Matrix com cara de Discord",
    "longDescription": "Glitch: cliente do protocolo Matrix com servidores, canais de voz, chamadas e transmissões no estilo do Discord.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "linux": {
      "deb": {
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
